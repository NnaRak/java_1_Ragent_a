# 复制成 .env 后填实际值：cp .env.example .env
# .env 已被 .gitignore 排除，不会入库。变量名与 application-local.yaml 里引用的保持一致。

# PostgreSQL（首次初始化数据卷时生效；卷已存在的话改这里不会重置库里的口令，
# 需要 docker compose down -v 重建，或进容器 ALTER USER）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragent

# 对象存储 S3 凭证（RustFS 的 admin，同时也是 Milvus/文档存储用的那对）
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key
